    "将为 %@ 生成一张账单，汇总所选课时。家长收到的是一张总账，不是每节课单独一张。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A bill will be created for %@ with the selected lessons. Parents get one total bill, not one per lesson."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将为 %@ 生成一张账单，汇总所选课时。家长收到的是一张总账，不是每节课单独一张。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將為 %@ 產生一張帳單，彙總所選課時。家長收到的是一張總帳，不是每節課單獨一張。"
          }
        }
      }
    },
    "将永久删除该学生及其所有课时、账单和课包记录，此操作不可恢复。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This permanently deletes the student and all lessons, bills, and package records. This cannot be undone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将永久删除该学生及其所有课时、账单和课包记录，此操作不可恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將永久刪除該學生及其所有課時、帳單和課包記錄，此操作不可恢復。"
          }
        }
      }
    },
